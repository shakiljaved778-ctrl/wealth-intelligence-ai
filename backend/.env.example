# Copy to .env. All settings are prefixed WIA_ (see app/core/config.py).
WIA_ENV=dev
WIA_SECRET_KEY=change-me-in-prod-use-a-long-random-string
WIA_ACCESS_TOKEN_EXPIRE_MINUTES=30
WIA_REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Storage (scaffold defaults to in-memory; set these for real deployments)
WIA_DATABASE_URL=postgresql+psycopg://wia:wia@localhost:5432/wia
WIA_REDIS_URL=redis://localhost:6379/0

# Data residency: qa | eu | global  (drives storage/routing)
WIA_DEFAULT_DATA_REGION=global

# AI provider config (stubbed by default — no key needed to run the scaffold)
WIA_LLM_PROVIDER=stub
WIA_LLM_MODEL=stub-llm-v0
WIA_LLM_API_KEY=

# Compliance
WIA_ALLOW_PERSONALIZED_ADVICE=false
